# Copia este ficheiro para ".env" e muda o que precisares. O servidor lê-o ao arrancar.

# Porta HTTP (por omissão 3000)
PORT=3000

# Pasta onde as salas são guardadas em JSON quando não há base de dados (por omissão ./data)
DATA_DIR=./data

# Base de dados PostgreSQL (opcional). Com isto preenchido, as salas passam a ser guardadas na BD
# e as que já existiam na pasta data/ são copiadas automaticamente.
# Exemplo (Neon): postgresql://utilizador:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Séries e filmes (opcional): chave grátis do TMDB, em https://www.themoviedb.org/settings/api
# Serve a "API Key" ou o "API Read Access Token". Sem isto, só há salas de anime.
TMDB_API_KEY=
