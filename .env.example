# Copia este ficheiro para ".env" e muda o que precisares. O servidor lê-o ao arrancar.

# Porta HTTP (por omissão 3000)
PORT=3000

# Pasta onde as salas são guardadas em JSON quando não há base de dados (por omissão ./data)
DATA_DIR=./data

# Base de dados PostgreSQL (opcional). Com isto preenchido, as salas passam a ser guardadas na BD
# e as que já existiam na pasta data/ são copiadas automaticamente.
# Exemplo (Neon): postgresql://utilizador:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Séries e filmes (opcional): chave grátis do TMDB, em https://www.themoviedb.org/settings/api
# Serve a "API Key" ou o "API Read Access Token". Sem isto, só há salas de anime.
TMDB_API_KEY=

# Código da comunidade (opcional): se definido, só quem o souber usa a app (colaboradores).
COMMUNITY_CODE=

# Fotos (opcional): espaço máximo para as fotos de restaurantes, sítios, etc., em MB (por omissão 300).
# O Neon gratuito tem 512 MB para tudo (salas, contas e fotos).
PHOTOS_MAX_MB=

# Moderação da comunidade (opcional): nomes de utilizador de contas (ou emails das contas Google)
# que podem apagar qualquer título ou foto na comunidade, separados por vírgulas. Ex.: ADMINS=ana,rui
ADMINS=

# Entrar com a Google (opcional): o Client ID do projeto na Google Cloud (vê o README) e os domínios
# do Google Workspace da empresa, separados por vírgulas. Só as contas desses domínios entram com a
# Google; com COMMUNITY_CODE, também abrem a app sem o código.
GOOGLE_CLIENT_ID=
GOOGLE_DOMAIN=grupolusiaves.pt,lusiaves.pt
